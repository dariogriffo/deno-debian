#!/usr/bin/make -f
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
DENO_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/[-~].*//')

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	@arch="$(DEB_HOST_ARCH)"; \
	case "$$arch" in \
		amd64) DENO_ARCH="x86_64-unknown-linux-gnu" ;; \
		arm64) DENO_ARCH="aarch64-unknown-linux-gnu" ;; \
		*) echo "Unsupported architecture: $$arch"; exit 1 ;; \
	esac; \
	echo "Downloading deno-$$DENO_ARCH for $(DENO_VERSION)..."; \
	wget -q "https://github.com/denoland/deno/releases/download/v$(DENO_VERSION)/deno-$$DENO_ARCH.zip"; \
	unzip -o "deno-$$DENO_ARCH.zip" deno; \
	rm -f "deno-$$DENO_ARCH.zip"; \
	echo "Downloading denort-$$DENO_ARCH for $(DENO_VERSION)..."; \
	wget -q "https://github.com/denoland/deno/releases/download/v$(DENO_VERSION)/denort-$$DENO_ARCH.zip"; \
	unzip -o "denort-$$DENO_ARCH.zip" denort; \
	rm -f "denort-$$DENO_ARCH.zip"

override_dh_auto_install:
	install -D -m 755 deno debian/deno/usr/bin/deno
	install -D -m 755 denort debian/denort/usr/bin/denort

override_dh_auto_test:

override_dh_auto_clean:
	rm -f deno denort

override_dh_strip:

override_dh_shlibdeps:
